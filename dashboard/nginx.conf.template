# Rendered by the nginx image's envsubst entrypoint into /etc/nginx/conf.d/default.conf.
# Only the API_KEY environment variable is substituted (NGINX_ENVSUBST_FILTER in the Dockerfile),
# so nginx's own $variables are untouched. API_KEY must be set on the container (see docker-compose.yml).
#
# Routing policy — the browser only gets what the dashboard needs:
#   GET  /collector/*                         -> collector (read-only)
#   GET  /api/{model-info,feature-importance,drift,alert-config} -> prediction-api
#   POST/DELETE /api/alert-config/recipients  -> prediction-api (+ X-API-Key)
#   POST /api/alert/test                      -> prediction-api (+ X-API-Key)
#   POST /api/{service}/{simulate_failure,reset} -> service (+ X-API-Key)
# /predict and /predict/batch are NOT exposed: only the collector calls them.
#
# Trust boundary: Nginx adds the demo X-API-Key for these few routes, so anyone who can
# reach the dashboard can use them. That is acceptable for a local demo; production would
# put real user auth (e.g. SSO via oauth2-proxy) in front of this server.

server {
    listen 80;
    server_name _;
    server_tokens off;

    # Docker's embedded DNS; lets upstreams be resolved at request time.
    resolver 127.0.0.11 valid=10s ipv6=off;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'" always;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Request-ID $request_id;
    proxy_http_version 1.1;
    proxy_read_timeout 10s;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        expires 7d;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location /collector/ {
        limit_except GET { deny all; }
        set $collector collector:8005;
        rewrite ^/collector/(.*)$ /$1 break;
        proxy_pass http://$collector;
    }

    location ~ ^/api/(model-info|feature-importance|drift|alert-config)$ {
        limit_except GET { deny all; }
        set $prediction_api prediction-api:8004;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$prediction_api;
    }

    location ~ ^/api/(alert-config/recipients(/[0-9]+)?|alert/test)$ {
        limit_except POST DELETE { deny all; }
        set $prediction_api prediction-api:8004;
        proxy_set_header X-API-Key "${API_KEY}";
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$prediction_api;
    }

    location ~ ^/api/(payment|order|notification)/(simulate_failure|reset)$ {
        limit_except POST { deny all; }
        set $target $1-service:8000;
        proxy_set_header X-API-Key "${API_KEY}";
        rewrite ^/api/[a-z]+/(.*)$ /$1 break;
        proxy_pass http://$target;
    }

    location ~ ^/api/(payment|order|notification)/(health|traces|metrics)$ {
        limit_except GET { deny all; }
        set $target $1-service:8000;
        rewrite ^/api/[a-z]+/(.*)$ /$1 break;
        proxy_pass http://$target;
    }

    location /api/ {
        return 404;
    }
}
