# Copy to .env and adjust. Never commit .env.

# Shared key for mutating API calls (X-API-Key). The compose default
# "local-demo-key" is a documented, non-secret value for local demos only.
API_KEY=change-me

# Comma-separated browser origins allowed by CORS on the prediction API.
CORS_ORIGINS=http://localhost:5173

# Optional SMTP settings. If any of SMTP_SERVER/SMTP_USER/SMTP_PASSWORD/SENDER_EMAIL
# is empty, email alerts are disabled and /health reports alerts_enabled=false.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=
# Optional first recipient, added only if the recipient store is empty.
DEFAULT_RECIPIENT=
